class Solution {
public:
   struct Cell {
    int height, row, col;
    Cell(int h, int r, int c) : height(h), row(r), col(c) {}
};

// Comparator for the min-heap (priority queue)
struct Compare {
    bool operator()(const Cell& a, const Cell& b) {
        return a.height > b.height;  // Min-heap based on height
    }
};

int trapRainWater(vector<vector<int>>& heightMap) {
    if (heightMap.empty() || heightMap[0].empty()) return 0;

    int rows = heightMap.size();
    int cols = heightMap[0].size();

    // Min-heap to store the boundary cells
    priority_queue<Cell, vector<Cell>, Compare> minHeap;

    // Visited matrix to track visited cells
    vector<vector<bool>> visited(rows, vector<bool>(cols, false));

    // Step 1: Add all boundary cells to the heap
    for (int r = 0; r < rows; ++r) {
        for (int c : {0, cols - 1}) {  // Left and right boundaries
            minHeap.push(Cell(heightMap[r][c], r, c));
            visited[r][c] = true;
        }
    }
    for (int c = 0; c < cols; ++c) {
        for (int r : {0, rows - 1}) {  // Top and bottom boundaries
            minHeap.push(Cell(heightMap[r][c], r, c));
            visited[r][c] = true;
        }
    }

    // Step 2: Process the heap
    int trappedWater = 0;
    int waterLevel = 0;
    vector<pair<int, int>> directions = {{0, 1}, {1, 0}, {0, -1}, {-1, 0}};

    while (!minHeap.empty()) {
        Cell cell = minHeap.top();
        minHeap.pop();

        waterLevel = max(waterLevel, cell.height);  // Update water level

        // Check all 4 neighbors
        for (const auto& dir : directions) {
            int nr = cell.row + dir.first;
            int nc = cell.col + dir.second;

            if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && !visited[nr][nc]) {
                visited[nr][nc] = true;
                trappedWater += max(0, waterLevel - heightMap[nr][nc]);  // Calculate trapped water
                minHeap.push(Cell(max(heightMap[nr][nc], waterLevel), nr, nc));  // Add neighbor to the heap
            }
        }
    }

    return trappedWater;
}
};


